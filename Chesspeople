<!DOCTYPE html>
<html>
<head>
  <title>Chess Clicker</title>
</head>
<body style="background:#111;color:white;text-align:center;font-family:Arial">

<h1>♟️ Chess Clicker</h1>
<h2>Pieces: <span id="score">0</span></h2>

<button onclick="clickPiece()" style="font-size:20px">Collect Piece</button>
<br><br>
<button onclick="buyPawn()">Buy Pawn (+1/sec) – 10</button>

<script>
let score = 0;
let pawns = 0;

function clickPiece() { score++; update(); }

function buyPawn() {
  if (score >= 10) {
    score -= 10;
    pawns++;
    update();
  }
}

// Passive pieces every second
setInterval(() => {
  score += pawns;
  update();
}, 1000);

function update() {
  document.getElementById("score").innerText = score;
}

// Save/load from localStorage
const save = JSON.parse(localStorage.getItem("chessClickerSave"));
if (save) {
  score = save.score;
  pawns = save.pawns;
  update();
}

setInterval(() => {
  localStorage.setItem("chessClickerSave", JSON.stringify({score, pawns}));
}, 5000);
</script>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
  <title>Pawn Runner</title>
</head>
<body style="background:black;color:white;text-align:center;font-family:Arial">

<h1>🏃 Pawn Runner</h1>
<p>Click as fast as you can!</p>
<h2>Score: <span id="run">0</span></h2>

<button onclick="run()" style="font-size:20px">RUN</button>

<script>
let runScore = 0;

function run() {
  runScore++;
  document.getElementById("run").innerText = runScore;
}
</script>

</body>
</html>
